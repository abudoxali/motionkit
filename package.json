{
  "name": "abud-motion-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first motion graphics workspace for coding agents · by ABUD FUN",
  "type": "module",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "vite --host 127.0.0.1",
    "library": "vite --host 127.0.0.1",
    "studio": "remotion studio src/remotion.ts --no-open",
    "studio:open": "remotion studio src/remotion.ts",
    "stills": "node scripts/stills.mjs",
    "qa:typography": "node scripts/qa-typography.mjs",
    "reference:import": "tsx scripts/import-reference.ts",
    "asset:import": "tsx scripts/asset.ts import",
    "asset:list": "tsx scripts/asset.ts list",
    "voiceover:align": "tsx scripts/asset.ts voiceover",
    "qa:media": "tsx scripts/qa-media.ts",
    "reference:analyze": "uv run --no-project --with numpy --with pillow python .agents/skills/motion-from-reference/scripts/analyze.py",
    "audio:align": "uv run --no-project python .agents/skills/motion-from-reference/scripts/align.py",
    "audio:sfx": "uv run --no-project --with numpy python .agents/skills/motion-from-reference/scripts/sfx.py",
    "audio:music": "uv run --no-project --with numpy python .agents/skills/motion-from-reference/scripts/music.py",
    "export": "tsx scripts/manual-export.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --project=typography --project=presets",
    "test:visual:update": "playwright test --project=typography --project=presets --update-snapshots=changed",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "validate": "npm run test && npm run typecheck && npm run build",
    "projects:validate": "tsx scripts/validate-projects.ts",
    "skills:sync": "node scripts/sync-skill-adapters.mjs",
    "project:new": "tsx scripts/project-new.ts",
    "doctor": "node scripts/doctor.mjs",
    "release:package": "node scripts/package-release.mjs",
    "release:verify": "node scripts/verify-clean-checkout.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.533",
    "@remotion/cli": "4.0.533",
    "@remotion/player": "4.0.533",
    "@remotion/renderer": "4.0.533",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.533"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.5.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "27.0.0",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=20"
  }
}
